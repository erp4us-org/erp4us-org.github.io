---
import {
  catalogs,
  languages,
  pages,
  path,
  repo,
  actions,
  signals,
  type Locale,
  type Page,
} from "../site";
import "../style.css";
export function getStaticPaths() {
  return (Object.keys(catalogs) as Locale[]).flatMap((locale) =>
    pages.map((page) => ({
      params: {
        route:
          path(locale, page).split("/").filter(Boolean).join("/") || undefined,
      },
      props: { locale, page },
    })),
  );
}
const { locale, page } = Astro.props as { locale: Locale; page: Page };
const t = (k: string) =>
  (catalogs[locale] as Record<string, string>)[k] ??
  (catalogs.en as Record<string, string>)[k];
const group = (g: string) =>
  Object.keys(catalogs.en).filter((k) => k.startsWith(g + "."));
const snap = await signals;
const home = page === "home",
  title = t(home ? "hero" : "nav." + page),
  intro = t(
    home ? "subtitle" : page === "roadmap" ? "roadintro" : page + ".intro",
  );
const url = new URL(path(locale, page), Astro.site);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | erp4us</title>
    <meta name="description" content={intro} />
    <link rel="canonical" href={url} />
    {Object.keys(languages).map((l) => (
      <link
        rel="alternate"
        hreflang={l}
        href={new URL(path(l as Locale, page), Astro.site)}
      />
    ))}
    <link rel="icon" href="/brand/favicon.svg" />
    <link rel="stylesheet" href="/brand/tokens.css" />
    <script is:inline>
      try {
        const theme = localStorage.getItem("erp4us.site.theme");
        if (theme === "light" || theme === "dark")
          document.documentElement.dataset.theme = theme;
      } catch {
        /* Follow system preference when storage is unavailable. */
      }
    </script>
    <meta property="og:title" content={`${title} | erp4us`} />
    <meta property="og:description" content={intro} />
    <meta
      property="og:image"
      content={new URL("/brand/social.png", Astro.site)}
    />
  </head>
  <body>
    <a class="skip" href="#content">
      {t("skip")}
    </a>
    <header>
      <a class="word" href={path(locale, "home")} aria-label="erp4us">
        <img src="/brand/symbol.svg" alt="" width="36" height="36" />
        erp<b>4</b>us
      </a>
      <nav aria-label={t("nav.site")}>
        {pages.slice(1).map((p) => (
          <a
            href={path(locale, p)}
            aria-current={p === page ? "page" : undefined}
          >
            {t("nav." + p)}
          </a>
        ))}
      </nav>
      <nav class="utility" aria-label={t("language")}>
        {Object.entries(languages).map(([l, name]) => (
          <a
            lang={l}
            href={path(l as Locale, page)}
            aria-current={l === locale ? "true" : undefined}
          >
            {name}
          </a>
        ))}
        <label class="sr-only" for="site-theme">
          {t("theme.label")}
        </label>
        <select id="site-theme" hidden>
          <option value="system">{t("theme.system")}</option>
          <option value="light">{t("theme.light")}</option>
          <option value="dark">{t("theme.dark")}</option>
        </select>
      </nav>
    </header>
    <main id="content">
      <section class:list={["hero", { home }]}>
        <div>
          {home && <p class="eyebrow">{t("early")}</p>}
          <h1>{title}</h1>
          <p class="lead">{intro}</p>
          {home && (
            <div class="buttons">
              <a href={path(locale, "vision")}>
                {t("explore")} <span aria-hidden="true">→</span>
              </a>
              <a href={actions.first}>
                {t("join")} <span aria-hidden="true">↗</span>
              </a>
            </div>
          )}
        </div>
        {home && (
          <figure class="preview">
            <figcaption>{t("preview.caption")}</figcaption>
            <div class="preview-window">
              <div class="preview-header">
                <img src="/brand/symbol.svg" width="23" height="23" alt="" />
                <strong>erp4us</strong>
              </div>
              <div class="preview-body">
                <div class="preview-rail">
                  <span>{t("preview.workspace")}</span>
                  <strong>{t("preview.master")}</strong>
                </div>
                <div class="preview-content">
                  <span>
                    {t("preview.master")} / {t("preview.products")}
                  </span>
                  <strong class="preview-title">{t("preview.products")}</strong>
                  <div class="preview-card">
                    <b>{t("preview.register")}</b>
                    <span>
                      <code>SKU</code> · {t("preview.name")}
                    </span>
                  </div>
                  <div class="preview-card">
                    <b>{t("preview.lookup")}</b>
                  </div>
                </div>
              </div>
            </div>
          </figure>
        )}
      </section>
      {(home || page === "roadmap") && (
        <section class="capabilities">
          <h2>{t("domains")}</h2>
          <p>{t("status")}</p>
          <dl>
            {[
              ["available", "now"],
              ["active", "working"],
              ["experimental", "draft"],
              ...group("domain").map((k) => ["planned", k]),
            ].map(([s, k]) => (
              <div>
                <dt>{t(k)}</dt>
                <dd class:list={["capability", s]}>{t(s)}</dd>
              </div>
            ))}
          </dl>
        </section>
      )}
      {page === "vision" && (
        <>
          <h2>{t("principles")}</h2>
          <ul class="cards">
            {group("principle").map((k) => (
              <li>{t(k)}</li>
            ))}
          </ul>
        </>
      )}
      {page === "architecture" && (
        <>
          <figure class="architecture">
            <figcaption>{t("path")}</figcaption>
            <ol class="diagram">
              {["layer1", "layer2", "layer3", "layer4"].map((k) => (
                <li>{t(k)}</li>
              ))}
            </ol>
          </figure>
          <section aria-labelledby="technology-stack">
            <h2 id="technology-stack">{t("stack.heading")}</h2>
            <h3>{t("stack.local")}</h3>
            <p>{t("stack.localNote")}</p>
            <ul class="cards">
              {[
                "angular",
                "rust",
                "mongodb",
                "contracts",
                "compose",
                "nats",
              ].map((key) => (
                <li>
                  <strong>{t(`stack.${key}.name`)}</strong>
                  <p>{t(`stack.${key}.detail`)}</p>
                </li>
              ))}
            </ul>
            <h3>{t("stack.planned")}</h3>
            <ul class="cards">
              {["identity", "storage", "kubernetes", "mcp"].map((key) => (
                <li>
                  <strong>{t(`stack.${key}.name`)}</strong>
                  <p>{t(`stack.${key}.detail`)}</p>
                </li>
              ))}
            </ul>
            <h3>{t("stack.sources")}</h3>
            <ul>
              <li>
                <a href={repo + "#run-the-first-slice"}>
                  {t("stack.quickstart")}
                </a>
              </li>
              <li>
                <a href={repo + "/tree/main/docs/adr"}>
                  {t("stack.decisions")}
                </a>
              </li>
              <li>
                <a href={repo + "/blob/main/ROADMAP.md"}>{t("nav.roadmap")}</a>
              </li>
            </ul>
          </section>
        </>
      )}
      {page === "industries" && (
        <ul class="cards">
          {group("industry").map((k) => (
            <li>{t(k)}</li>
          ))}
        </ul>
      )}
      {page === "roadmap" && (
        <>
          <ol class="steps">
            {group("phase").map((k) => (
              <li>{t(k)}</li>
            ))}
          </ol>
          <a href={repo + "/blob/main/ROADMAP.md"}>{t("source")} ↗</a>
        </>
      )}
      {(page === "community" || page === "contribute") && (
        <div class="cards">
          {Object.entries(actions).map(([k, href]) => (
            <a href={href}>{t(k)} ↗</a>
          ))}
        </div>
      )}
      {home && snap && (
        <section>
          <h2>{t("signal")}</h2>
          <p>
            <a href={repo + "/stargazers"}>
              {snap.stars} {t("stars")}
            </a>{" "}
            · {t("snapshot")}: <time>{snap.date}</time>
          </p>
        </section>
      )}
    </main>
    <footer>
      <strong>{t("slogan")}</strong>
      <nav>
        <a href={repo + "/tree/main/docs"}>{t("docs")}</a>
        <a href={repo}>{t("github")} ↗</a>
      </nav>
    </footer>
    <script>
      const select = document.querySelector<HTMLSelectElement>("#site-theme");
      if (select) {
        const root = document.documentElement;
        select.value = root.dataset.theme ?? "system";
        select.hidden = false;
        select.addEventListener("change", () => {
          if (select.value === "system") delete root.dataset.theme;
          else root.dataset.theme = select.value;
          try {
            localStorage.setItem("erp4us.site.theme", select.value);
          } catch {
            /* The explicit theme still applies for this page. */
          }
        });
      }
    </script>
  </body>
</html>
